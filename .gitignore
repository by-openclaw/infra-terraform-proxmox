# Terraform state — NEVER commit state files (contains sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files: none are used — secrets come from Vault through
# ansible-platform playbooks/terraform.yml. Still ignored, as a safety net.
*.tfvars

# Terraform working directory
.terraform/

# Plan files (may contain secrets)
*.tfplan
tfplan

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# SSH keys that may accidentally end up here
*.pem
*.key
id_rsa*
id_ed25519*

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# python bytecode (seed build script)
__pycache__/
