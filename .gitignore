# Terraform state — NEVER commit state files (contains sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with secrets — use *.tfvars.example for templates
*.tfvars
!*.tfvars.example

# Terraform working directory
.terraform/

# Plan files (may contain secrets)
*.tfplan
tfplan

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# SSH keys that may accidentally end up here
*.pem
*.key
id_rsa*
id_ed25519*

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
