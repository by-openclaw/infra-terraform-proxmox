# Copy this file to terraform.tfvars and fill in the values.
# NEVER commit terraform.tfvars to git — it contains secrets.

# Proxmox API endpoint for PoC node
proxmox_api_url = "https://10.6.224.105:8006/api2/json"

# API token — create in Proxmox: Datacenter → API Tokens
# Requires: VM.Allocate, VM.Config.*, Datastore.AllocateSpace, SDN.Use
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
